{
  "name": "safevault",
  "version": "1.2.2",
  "type": "module",
  "private": true,
  "description": "零知识强加密个人密码数据库 (支持极空间NAS私有化部署、多端同步与GitHub更新)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "node tests/test-crypto.js && node tests/test-audit-totp.js && node tests/test-secondary-auth.js && node tests/test-advanced-features.js && node tests/test-sync-protocol.js",
    "desktop": "npm run build && electron electron/main.cjs",
    "desktop:refresh": "npm run build && electron electron/main.cjs --safevault-refresh",
    "docs:build": "python docs/generate_design_doc.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^44.4.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
